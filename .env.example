# Kopieer naar .env (lokaal) of zet als Environment Variables in Vercel.
# CMS_URL wijst naar het centrale CMS (linkandlead.nl) waar het kennismaking-endpoint
# de lead naartoe stuurt (api/kennismaking.js). Zonder waarde valt het endpoint terug op
# de standaard-URL.

CMS_URL=https://linkandlead.nl
